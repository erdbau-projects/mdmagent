# Copia questo file in "keystore.properties" (stessa cartella, app/) e
# riempi i valori reali. keystore.properties NON va versionato (vedi
# .gitignore) e non va condiviso via chat/email: solo vault aziendale.

# Percorso assoluto al file .keystore generato con keytool (step 3).
# Su Windows usa doppio backslash oppure gli slash normali:
storeFile=C:\\path\\assoluto\\a\\mdmagent-release.keystore

storePassword=CHANGE_ME
keyAlias=mdmagent
keyPassword=CHANGE_ME
