<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        Barra di stato in alto: fa anche da zona per il gesto di uscita
        manutenzione (7 tap ravvicinati). Piccola apposta per lasciare
        spazio alla griglia delle app sotto.
    -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/status_not_device_owner" />

    <Button
        android:id="@+id/exitMaintenanceButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text="@string/button_reenter_kiosk"
        android:visibility="gone" />

    <!--
        Griglia delle app del launcher: popolata a runtime in MainActivity
        da assets/launcher_apps.json, un pulsante per ogni app installata.
    -->
    <GridLayout
        android:id="@+id/appGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="3"
        android:padding="24dp"
        android:gravity="center" />

</LinearLayout>
